{
  "name": "cuddly-umbrella",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "kfc:dlc:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./kfc-dlc-pack.ps1",
    "kfc:dlc:publish": "node kfc-publish.mjs --manifest dlcs/bifrost/kfc.manifest.json",
    "mcp:build": "pnpm --filter @cuddly/mcp-server build",
    "mcp:login": "node apps/mcp-server/dist/main.js login",
    "mcp:status": "node apps/mcp-server/dist/main.js status",
    "mcp:logout": "node apps/mcp-server/dist/main.js logout",
    "product:sync": "pnpm --filter @cuddly/browser-extension sync:product-name",
    "kfc:validate": "node validate-manifest.mjs kfc.manifest.json && node validate-manifest.mjs apps/browser-extension/kfc.manifest.json",
    "kfc:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./kfc-pack.ps1",
    "kfc:publish": "pnpm product:sync && node kfc-publish.mjs",
    "kfc:publish:extension": "pnpm product:sync && node kfc-publish.mjs --manifest apps/browser-extension/kfc.manifest.json",
    "kfc:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./kfc-release.ps1",
    "prebuild": "pnpm product:sync",
    "build": "pnpm -r --if-present build",
    "dev:control": "pnpm --filter @cuddly/control-api dev",
    "dev:gateway": "pnpm --filter @cuddly/gateway dev",
    "dev:console": "pnpm --filter @cuddly/console dev",
    "dev:worker": "pnpm --filter @cuddly/build-worker dev",
    "dev:runner": "pnpm --filter @cuddly/runner-agent dev",
    "dev": "concurrently -n control,gateway,console -c blue,green,magenta \"pnpm dev:control\" \"pnpm dev:gateway\" \"pnpm dev:console\"",
    "pretypecheck": "pnpm product:sync",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm product:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @cuddly/db migrate"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.2.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
