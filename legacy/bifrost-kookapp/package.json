{
  "name": "bifrost-kookapp",
  "version": "1.0.0",
  "main": "src/main.ts",
  "license": "MIT",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "next-version": "bun run typecheck && git add --all && git commit -m \"chore: next version\" && git push"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bun": "^1.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
