server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bifrost-api-mobile.vanillacake.cn;
    client_max_body_size 128M;

    location / {
        proxy_pass http://127.0.0.1:9872;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }

    ssl_certificate /etc/letsencrypt/live/bifrost.vanillacake.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bifrost.vanillacake.cn/privkey.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name bifrost-api-mobile.vanillacake.cn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
